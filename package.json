{
  "name": "skyflow-node-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Skyflow Node SDK monorepo (common / skyvault / flowvault)",
  "workspaces": [
    "common",
    "skyvault",
    "flowvault"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:clean": "tsc -b --clean",
    "build:dist": "npm run build:dist --workspace skyvault && npm run build:dist --workspace flowvault",
    "contract-snapshot": "npm run build && npm run build:dist && npm run contract-snapshot --workspace skyvault && npm run contract-snapshot --workspace flowvault",
    "contract-snapshot-verify": "npm run build && npm run build:dist && npm run contract-snapshot-verify --workspace skyvault && npm run contract-snapshot-verify --workspace flowvault",
    "test": "npm run test --workspaces --if-present",
    "eslint": "eslint '**/*.{js,ts}' --max-warnings 0",
    "prettier": "prettier --list-different '**/*.{js,ts}'",
    "lint": "npm run eslint",
    "lint-fix": "prettier --write '**/*.{js,ts}' && eslint --fix '**/*.{js,ts}'",
    "spellcheck": "cspell '**/*.{ts,js,md}'",
    "patch-generated-secrets": "node scripts/patch-generated-secrets.js",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skyflowapi/skyflow-node-sdk.git"
  },
  "author": "",
  "license": "MIT",
  "keywords": [
    "skyflow",
    "privacy",
    "api",
    "security",
    "vault",
    "PII",
    "tokenization"
  ],
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "7.29.0",
    "@babel/plugin-transform-object-assign": "7.27.1",
    "@babel/plugin-transform-runtime": "7.29.0",
    "@babel/preset-env": "7.29.5",
    "@babel/preset-typescript": "7.29.7",
    "@babel/runtime": "7.29.2",
    "@microsoft/api-extractor": "7.58.7",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.20",
    "@types/node-fetch": "2.6.13",
    "@types/qs": "6.15.1",
    "@types/readable-stream": "4.0.23",
    "@types/url-join": "4.0.1",
    "cspell": "9.8.0",
    "eslint": "9.39.4",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "ts-jest": "29.4.11",
    "tsup": "^8.5.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.59.3"
  }
}
