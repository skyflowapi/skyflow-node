{
  "name": "skyflow-node",
  "version": "2.1.2",
  "description": "Skyflow SDK for Node.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:dist": "tsup",
    "test": "jest --coverage",
    "contract-snapshot": "api-extractor run --local",
    "contract-snapshot-verify": "api-extractor run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skyflowapi/skyflow-node-sdk.git"
  },
  "browser": {
    "child_process": false
  },
  "author": "",
  "license": "MIT",
  "keywords": [
    "skyflow",
    "privacy",
    "api",
    "security",
    "vault",
    "PII",
    "tokenization"
  ],
  "dependencies": {
    "dotenv": "16.6.1",
    "form-data": "4.0.6",
    "form-data-encoder": "4.1.0",
    "formdata-node": "6.0.3",
    "js-base64": "3.7.7",
    "jsonwebtoken": "9.0.3",
    "jwt-decode": "4.0.0",
    "node-fetch": "2.7.0",
    "qs": "6.15.2",
    "readable-stream": "4.7.0",
    "url-join": "4.0.1"
  },
  "devDependencies": {
    "skyflow-common": "*"
  }
}
